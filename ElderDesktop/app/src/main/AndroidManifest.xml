<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 电话 / 短信：仅在子女设置模式一次性申请，长辈使用阶段不再弹窗 -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <!-- 不申请：定位、存储、后台、推送（技术方案 §6） -->

    <!-- 功能3：可见并启动白名单第三方应用（抖音/微信/快手）；采用 queries 点名，不使用 QUERY_ALL_PACKAGES -->
    <queries>
        <package android:name="com.ss.android.ugc.aweme" />
        <package android:name="com.tencent.mm" />
        <package android:name="com.smile.gifmaker" />
    </queries>

    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <application
        android:name=".ElderApp"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ElderDesktop"
        tools:targetApi="34">

        <!-- 桌面入口：MAIN + HOME + DEFAULT，设为默认桌面后开机直达 -->
        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.ElderDesktop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- 普通入口（桌面图标）：子女设置模式 / 普通浏览 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.ElderDesktop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
